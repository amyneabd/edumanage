# Copy this file to .env and fill in real values. Never commit .env.

# SQLite file location (relative to server/prisma). Swap for a Postgres/MySQL
# connection string later if you outgrow SQLite — Prisma handles the rest.
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT session cookies. Use a long random string in
# production (e.g. `openssl rand -hex 32`) — never reuse the dev value below.
JWT_SECRET="dev-secret-change-me-in-production"

# Port the Express server listens on.
PORT=4000

# Origin of the client app, used for CORS and for building links in emails
# (e.g. password reset links).
CLIENT_ORIGIN="http://localhost:5173"

# Credentials for the seeded admin account (created by `npm run prisma:seed`).
ADMIN_EMAIL="admin@bachandi.app"
ADMIN_PASSWORD="admin123"

# --- Optional: outgoing email (password reset) ---
# If SMTP_HOST is left unset, password reset links are logged to the server
# console instead of emailed — useful for local development. Once SMTP_HOST
# is set, SMTP_USER and SMTP_PASS become required.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="changeme"
# SMTP_FROM="Bachandi <no-reply@bachandi.app>"

# Set to "production" when deploying — enables secure cookies and disables
# the dev-only password-reset-link passthrough.
# NODE_ENV="production"
