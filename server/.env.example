# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (e.g. from Supabase: Project Settings > Database
# > Connection string > URI, using the pooler connection for app runtime).
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Secret used to sign JWT session cookies. Use a long random string in
# production (e.g. `openssl rand -hex 32`) — never reuse the dev value below.
JWT_SECRET="dev-secret-change-me-in-production"

# Port the Express server listens on.
PORT=4000

# Origin of the client app, used for CORS and for building links in emails
# (e.g. password reset links).
CLIENT_ORIGIN="http://localhost:5173"

# Credentials for the seeded admin account (created by `npm run prisma:seed`).
ADMIN_EMAIL="admin@bachandi.app"
ADMIN_PASSWORD="admin123"

# --- Optional: outgoing email (password reset, verification) ---
# Sent via Resend's HTTP API (not SMTP — many hosts block outbound SMTP).
# If RESEND_API_KEY is left unset, links are logged to the server console
# instead of emailed — useful for local development.
# RESEND_API_KEY="re_changeme"
# MAIL_FROM defaults to Resend's sandbox sender (onboarding@resend.dev),
# which works without domain verification but only delivers to the Resend
# account's own email. Once a sending domain is verified in Resend, set this
# to a real address on that domain (e.g. "Bachandi <no-reply@bachandi.app>").
# MAIL_FROM="Bachandi <onboarding@resend.dev>"

# Set to "production" when deploying — enables secure cookies and disables
# the dev-only password-reset-link passthrough.
# NODE_ENV="production"

# --- Optional: file uploads via Supabase Storage ---
# If SUPABASE_URL is left unset, uploaded files are written to local disk
# instead — useful for local development. Once SUPABASE_URL is set,
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_STORAGE_BUCKET become required.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="changeme"
# SUPABASE_STORAGE_BUCKET="uploads"
